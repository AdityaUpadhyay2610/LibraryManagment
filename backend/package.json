{
  "name": "library-management-backend",
  "version": "1.0.0",
  "description": "Library Management System Backend - Node.js + Express + PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "cd ../frontend && npm install && npm run build",
    "dev": "nodemon server.js",
    "db:init": "node db/seed.js",
    "db:migrate-mysql": "node db/migrateFromMySql.js",
    "notify:test": "node -e \"require('./services/notificationService').sendNotifications().then(() => process.exit(0)).catch((e) => { console.error(e); process.exit(1); })\"",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "multer": "^2.5.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.10",
    "pg": "^8.16.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.1.4"
  }
}
